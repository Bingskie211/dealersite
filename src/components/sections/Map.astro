<!-- ✅ Leaflet Map Script -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // @ts-ignore - Leaflet is loaded via CDN
    if (!window.L) {
      console.error("Leaflet not loaded");
      return;
    }

    // @ts-ignore - Leaflet is loaded via CDN
    const map = L.map("denverMap", { zoomControl: true }).setView(
      [39.7392, -104.9903],
      11
    );

    // @ts-ignore - Leaflet is loaded via CDN
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    // Demo boundaries
    const areas = [
      [
        [39.78, -105.08],
        [39.78, -104.91],
        [39.68, -104.91],
        [39.68, -105.08],
      ],
      [
        [39.75, -105.16],
        [39.75, -105.07],
        [39.68, -105.07],
        [39.68, -105.16],
      ],
      [
        [39.83, -105.14],
        [39.83, -105.03],
        [39.79, -105.03],
        [39.79, -105.14],
      ],
      [
        [39.76, -104.9],
        [39.76, -104.74],
        [39.66, -104.74],
        [39.66, -104.9],
      ],
      [
        [39.63, -104.97],
        [39.63, -104.84],
        [39.58, -104.84],
        [39.58, -104.97],
      ],
    ];

    // @ts-ignore - Leaflet is loaded via CDN
    const group = L.featureGroup().addTo(map);
    areas.forEach((coords) => {
      // @ts-ignore - Leaflet is loaded via CDN
      L.polygon(coords, {
        color: "#f97316",
        weight: 2.5,
        fillOpacity: 0,
      }).addTo(group);
    });

    map.fitBounds(group.getBounds(), { padding: [20, 20] });
  });
</script>