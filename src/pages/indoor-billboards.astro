---
import "../styles/global.css";
---

<header
  class="fixed top-0 inset-x-0 z-[999999] bg-white border-b border-black/5"
>
  <!-- Toggle checkbox -->
  <input id="nav-toggle" type="checkbox" class="peer sr-only" />

  <!-- BRAND BAR -->
  <div
    class="relative container mx-auto max-w-screen-xl px-4 sm:px-6 h-16 flex items-center"
  >
    <a
      href="/"
      class="inline-flex items-center gap-2 min-h-[44px]"
      aria-label="Home"
    >
      <img
        src="/images/TOP-SHELF-Advertising.webp"
        class="h-8 sm:h-10 w-auto"
        alt="TOP SHELF Advertising"
      />
    </a>
  </div>

  <!-- ALWAYS-VISIBLE HAMBURGER (fixed) -->
  <label
    for="nav-toggle"
    class="fixed top-2.5 right-3 inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-xl
           bg-white/95 text-[#15164c] ring-1 ring-black/10 hover:ring-black/20 shadow z-[1000000] cursor-pointer
           min-h-[44px] min-w-[44px]"
  >
    <span class="sr-only">Toggle menu</span>
    <span class="relative block h-5 w-6">
      <span
        class="absolute inset-x-0 top-0 h-0.5 bg-current transition-transform duration-200 peer-checked:rotate-45 peer-checked:translate-y-2"
      ></span>
      <span
        class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-0.5 bg-current transition-opacity duration-200 peer-checked:opacity-0"
      ></span>
      <span
        class="absolute inset-x-0 bottom-0 h-0.5 bg-current transition-transform duration-200 peer-checked:-rotate-45 peer-checked:-translate-y-2"
      ></span>
    </span>
  </label>

  <!-- DARK OVERLAY -->
  <div
    class="fixed inset-0 bg-black/40 z-[999998] hidden peer-checked:block transition-opacity duration-200"
  >
  </div>

  <!-- RIGHT DRAWER MENU -->
  <aside
    class="fixed top-0 right-0 h-screen w-80 max-w-[85vw] bg-white shadow-2xl z-[999999]
           translate-x-full peer-checked:translate-x-0 transition-transform duration-300 ease-out
           ring-1 ring-black/5"
  >
    <div
      class="h-16 px-4 sm:px-6 flex items-center justify-between border-b border-black/5"
    >
      <span class="font-semibold text-[#15164c] text-lg">Menu</span>
      <!-- Close button mirrors the same checkbox -->
      <label
        for="nav-toggle"
        class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg ring-1 ring-black/10 hover:ring-black/20 cursor-pointer min-h-[44px] min-w-[44px]"
      >
        <span class="sr-only">Close</span>
        <span class="relative block h-5 w-6 text-[#15164c]">
          <span
            class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-0.5 bg-current rotate-45"
          ></span>
          <span
            class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-0.5 bg-current -rotate-45"
          ></span>
        </span>
      </label>
    </div>

    <nav class="px-4 sm:px-6 py-4">
      <ul class="flex flex-col gap-2">
        <li>
          <a
            href="#"
            class="block rounded-lg px-3 py-3 text-[#15164c] font-semibold hover:bg-[#3b5de7]/5 transition min-h-[44px] flex items-center"
            >Home</a
          >
        </li>
        <li>
          <a
            href="#"
            class="block rounded-lg px-3 py-3 text-[#15164c] font-semibold hover:bg-[#3b5de7]/5 transition min-h-[44px] flex items-center"
            >Indoor Billboards</a
          >
        </li>
        <li>
          <a
            href="#"
            class="block rounded-lg px-3 py-3 text-[#15164c] font-semibold hover:bg-[#3b5de7]/5 transition min-h-[44px] flex items-center"
            >Solutions</a
          >
        </li>
        <li>
          <a
            href="#"
            class="block rounded-lg px-3 py-3 text-[#15164c] font-semibold hover:bg-[#3b5de7]/5 transition min-h-[44px] flex items-center"
            >About Us</a
          >
        </li>
        <li>
          <a
            href="#"
            class="block rounded-lg px-3 py-3 text-[#15164c] font-semibold hover:bg-[#3b5de7]/5 transition min-h-[44px] flex items-center"
            >Contact Us</a
          >
        </li>
      </ul>
    </nav>
  </aside>
</header>

<!-- Main content with proper mobile spacing -->
<main class="pt-16">
  <!-- Hero Section -->
  <section class="relative bg-white py-16 sm:py-20 md:py-24 lg:py-28">
    <div class="container mx-auto max-w-screen-xl px-4 sm:px-6">
      <div
        class="flex flex-col lg:flex-row items-center gap-8 sm:gap-12 lg:gap-16"
      >
        <!-- Left content -->
        <div class="w-full lg:w-1/2 text-center lg:text-left">
          <h1
            class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-[#15164c] leading-tight heading-responsive"
          >
            Indoor Digital Billboards
          </h1>
          <p
            class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-[#15164c]/80 text-responsive"
          >
            Reach your target audience with strategically placed digital
            displays in high-traffic indoor venues.
          </p>
          <div
            class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
          >
            <a
              href="#"
              class="inline-flex items-center justify-center h-12 sm:h-14 px-6 sm:px-8 rounded-lg bg-[#1d3dd1] text-white text-sm sm:text-base font-semibold hover:bg-[#1833b2] transition min-h-[44px] min-w-[44px]"
            >
              Get Started Today
            </a>
            <a
              href="#"
              class="inline-flex items-center justify-center h-12 sm:h-14 px-6 sm:px-8 rounded-lg border-2 border-[#1d3dd1] text-[#1d3dd1] text-sm sm:text-base font-semibold hover:bg-[#1d3dd1] hover:text-white transition min-h-[44px] min-w-[44px]"
            >
              Learn More
            </a>
          </div>
        </div>

        <!-- Right image -->
        <div class="w-full lg:w-1/2 mt-8 lg:mt-0">
          <div
            class="relative w-full max-w-[20rem] sm:max-w-[24rem] md:max-w-[28rem] lg:max-w-[32rem] mx-auto"
          >
            <img
              src="/images/download-5-1.avif"
              alt="Indoor digital billboard display"
              class="w-full h-auto rounded-2xl shadow-xl object-cover responsive-image"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-gray-50">
    <div class="container mx-auto max-w-screen-xl px-4 sm:px-6">
      <div class="text-center mb-12 sm:mb-16">
        <h2
          class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#15164c] heading-responsive"
        >
          Why Choose Indoor Digital Advertising?
        </h2>
        <p
          class="mt-4 text-base sm:text-lg text-[#15164c]/80 max-w-3xl mx-auto text-responsive"
        >
          Connect with customers in the moments that matter most with targeted,
          engaging digital displays.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        <div
          class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition card"
        >
          <div
            class="w-12 h-12 bg-[#3b5de7]/10 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-[#3b5de7]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-[#15164c] mb-3">
            High Visibility
          </h3>
          <p class="text-[#15164c]/70 text-responsive">
            Capture attention in high-traffic areas where your audience spends
            time.
          </p>
        </div>

        <div
          class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition card"
        >
          <div
            class="w-12 h-12 bg-[#3b5de7]/10 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-[#3b5de7]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-[#15164c] mb-3">
            Targeted Locations
          </h3>
          <p class="text-[#15164c]/70 text-responsive">
            Strategic placement in venues that align with your target
            demographic.
          </p>
        </div>

        <div
          class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition card sm:col-span-2 lg:col-span-1"
        >
          <div
            class="w-12 h-12 bg-[#3b5de7]/10 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-[#3b5de7]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-[#15164c] mb-3">
            Real-time Analytics
          </h3>
          <p class="text-[#15164c]/70 text-responsive">
            Track performance and optimize your campaigns with detailed
            insights.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<section
  class="relative overflow-hidden min-h-[60vh] py-28 md:py-40 flex items-center justify-center bg-[#0f1b46]"
>
  <!-- BG LAYERS (sibling, not parent!) -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <!-- Image: hidden on mobile, shown on md+ -->
    <img
      src="/images/testni.avif"
      alt=""
      class="hidden md:block w-full h-full object-cover object-center"
    />
    <!-- Overlay for readability on md+ -->
    <div class="hidden md:block absolute inset-0 bg-black/30"></div>
    <!-- Mobile fallback color is handled by the section's bg color -->
  </div>

  <!-- CONTENT -->
  <div class="relative z-10 container mx-auto max-w-screen-xl px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h1
        class="text-white font-extrabold leading-tight tracking-tight text-3xl md:text-4xl lg:text-5xl"
      >
        Local Advertising and Digital Marketing Pros in <span
          class="text-[#3b5de7]">Denver</span
        >
      </h1>

      <p class="mt-6 text-lg md:text-2xl text-white/90">
        Helping Businesses Get Noticed—On Screens and Online
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#"
          class="inline-flex items-center justify-center h-12 px-6 rounded-lg bg-[#1d3dd1] text-white text-sm md:text-base font-semibold hover:bg-[#1833b2] transition"
        >
          Contact Our Advertising Experts
        </a>
      </div>
    </div>
  </div>
</section>

<section class="relative bg-white py-15 md:py-28 lg:py-25">
  <div class="relative z-10 container mx-auto max-w-screen-xl px-4">
    <div
      class="flex flex-wrap md:flex-nowrap items-center gap-10 lg:gap-16 min-h-[20vh] lg:min-h-[50vh]"
    >
      <!-- Left -->
      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <h2
          class="text-[#15164c] font-bold leading-tight tracking-tight text-3xl"
        >
          Venue Partner Network
        </h2>

        <p class="mt-6 text-xl md:text-2xl text-[#15164c]/80 max-w-2xl">
          Our mission is to help local businesses like yours reach their
          audience. Every month, millions of consumers see our screens and
          remember them. <br />
          <br /> Join the network of businesses that are prioritizing hyper-local
          advertising!
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="#"
            class="inline-flex items-center justify-center h-12 px-6 rounded-lg bg-[#1d3dd1] text-white text-sm md:text-base font-semibold hover:bg-[#1833b2] transition"
          >
            Become a Venue Partner
          </a>
        </div>
      </div>

      <!-- Right -->
      <div class="w-full md:w-1/2 flex justify-center md:justify-end">
        <div class="relative w-[22rem] sm:w-[26rem] md:w-[32rem] lg:w-[36rem]">
          <div
            class="absolute inset-0 -z-10 hidden md:block rounded-3xl bg-[#15164c] opacity-90 rotate-[-3deg]"
          >
          </div>
          <img
            src="/images/third.avif"
            alt="Digital signage montage"
            class="block w-full h-auto rounded-3xl shadow-xl object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-20 bg-[#eaf2ff]">
  <div class="container mx-auto max-w-7xl px-4 text-center">
    <!-- Heading -->
    <h2 class="text-3xl md:text-4xl font-extrabold text-[#1d2a5b] mb-12">
      How do I Become a Venue Partner?
    </h2>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
      <!-- Card 1 -->
      <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition">
        <h3 class="text-xl font-bold text-[#1d2a5b] mb-2">
          Network Advertising
        </h3>
        <p class="text-black text-lg">
          One of the most enticing advantages of the network is that your
          venue's motion ads will be showcased in nearby non-competitive
          locations, enabling you to reach out to customers of other venues.
          Some of these customers might also be yours, thus enhancing your
          top-of-mind brand awareness and sparking word-of-mouth referrals.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition">
        <h3 class="text-xl font-bold text-[#1d2a5b] mb-2">
          Internal Advertising
        </h3>
        <p class="text-black text-lg">
          Participating in the network also provides you with the opportunity to
          engage with your customers while they are inside your establishment.
          Venues utilize screen time to inform, promote, or educate their
          customers about ongoing specials, promotions, or helpful tips.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition">
        <h3 class="text-xl font-bold text-[#1d2a5b] mb-2">Content Creation</h3>
        <p class="text-black text-lg">
          We handle all graphic content creation for our Venue Network Partners.
          Just provide us with a few design elements, pictures, and messages,
          and we’ll take it from there.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition">
        <h3 class="text-xl font-bold text-[#1d2a5b] mb-2">
          Access to Marketing Services
        </h3>
        <p class="text-black text-lg">
          Being part of our network also provides access to a variety of
          marketing services and our trained staff who manage them. From
          websites and social media to pay-per-click advertising, geofencing,
          and everything in between.
        </p>
      </div>

      <!-- Card 5 -->
      <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition">
        <h3 class="text-xl font-bold text-[#1d2a5b] mb-2">Local Support</h3>
        <p class="text-black text-lg">
          Whether it's a simple technical question, a content change, or an
          inquiry about marketing campaign options, we're here to meet with you
          and service your needs.
        </p>
      </div>

      <!-- Card 6 -->
      <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition">
        <h3 class="text-xl font-bold text-[#1d2a5b] mb-2">More Than Ads</h3>
        <p class="text-black text-lg">
          We go beyond continuous promotion of your business within the screen
          network, offering engaging content like weather updates, trivia, and
          fun facts to create a more enjoyable experience for customers.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 md:py-20 bg-white">
  <div class="container mx-auto w-7xl px-4">
    <!-- Heading -->
    <div class="max-w-full mx-auto text-center">
      <h2 class="text-4xl font-bold text-[#1d2a5b]">
        Boost Visibility with Our Full-Service Digital Marketing Solutions
      </h2>
      <p class="mt-4 text-black text-xl">
        Beyond in-venue ads, we provide full-scale digital marketing to help
        your business show up, stand out, and grow. Whether you're just getting
        started or need help scaling your outreach, we've got the tools and the
        team to support you.
      </p>
    </div>

    <!-- Grid -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-5">
      <!-- Left: big image, spans 2 rows -->
      <div class="relative lg:row-span-2">
        <!-- decorative back plate -->
        <div
          class="absolute -left-2 top-4 w-[94%] h-[94%] rounded-2xl bg-[#1d3dd1]/15 -z-10"
        >
        </div>

        <img
          src="/images/test2.avif"
          alt="Team working"
          class="w-full h-full object-cover rounded-2xl shadow-lg"
        />
      </div>

      <!-- Card 1 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- G icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 2a10 10 0 100 20 10 10 0 000-20Zm.2 15.2c-3.1 0-5.6-2.5-5.6-5.6s2.5-5.6 5.6-5.6c1.5 0 2.8.6 3.8 1.5l-1.5 1.5c-.6-.6-1.5-1-2.4-1-2 0-3.6 1.7-3.6 3.7s1.6 3.7 3.6 3.7c1.8 0 3.1-1 3.4-2.5H12v-2h5.6c.1.4.1.8.1 1.2 0 3.2-2.2 5.1-5.5 5.1Z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">
              Google Business Profile Optimization
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              Get found on Google Maps and local search.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 2 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- website icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" stroke-width="2"
              ></rect>
              <path d="M3 9h18" stroke-width="2"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">
              Website Design &amp; SEO
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              Fast, mobile-ready websites built for performance.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 3 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- hashtag icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M5 9h14M5 15h14M9 3L7 21M17 3l-2 18"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">Social Media Content</h3>
            <p class="mt-1 text-sm text-slate-600">
              Consistent posting and creative to grow your presence.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 4 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- arrow icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M5 12h14M13 5l7 7-7 7"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">
              Pay-Per-Click Advertising
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              Targeted ads that drive calls, clicks, and leads.
            </p>
          </div>
        </div>
      </a>

      <!-- Bottom wide card (spans full width on large screens) -->
      <a
        href="#"
        class="lg:col-span-3 rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- sparkles / info icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
