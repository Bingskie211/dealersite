                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </span>
            </button>

            <div
              x-ref="c3"
              :style="accordion ? 'height:' + $refs.c3.scrollHeight + 'px' : ''"
              class="overflow-hidden h-0 duration-500 ease-in-out"
