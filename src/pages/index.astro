---
import "../styles/global.css";
import Navbar from "../ui/navbar.astro";
import Footer from "../ui/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import ReachCustomers from "../components/sections/ReachCustomers.astro";
import VenuePartner from "../components/sections/VenuePartner.astro";
import BoostVisibility from "../components/sections/BoostVisibility.astro";
import WhyDenver from "../components/sections/WhyDenver.astro";
import CTA from "../components/sections/CTA.astro";
import FAQ from "../components/sections/FAQ.astro";
import Map from "../components/sections/Map.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Top Shelf Advertising - Denver Indoor Digital Signage</title>
    <meta name="description" content="Reach customers with indoor digital signage across Denver. Targeted advertising for restaurants, gyms, salons, retail spaces, and more." />
    
    <!-- Alpine.js -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body>
    <Navbar />
    <Hero />
    <ReachCustomers />
    <VenuePartner />
    <BoostVisibility />
    <WhyDenver />
    <CTA />
    <FAQ />
    <Map />
    <Footer />
  </body>
</html>
