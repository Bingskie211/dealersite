---
import "../styles/global.css";
---

<header
  class="fixed top-0 inset-x-0 z-50 bg-white backdrop-blur border-b border-white/10"
  x-data="{ mobileNavOpen: false }"
>
  <nav
    class="container mx-auto max-w-screen-xl px-4 h-16 lg:h-20 flex items-center"
  >
    <a href="#" class="inline-flex items-center gap-2" aria-label="Home">
      <img
        src="/images/TOP-SHELF-Advertising.webp"
        class="h-10 w-auto"
        alt="Brand"
      />
    </a>
    <ul class="hidden lg:flex ml-auto mr-6 items-center gap-8">
      <li>
        <a
          href="#"
          class="text-md text-[#15164c] font-semibold hover:text-white transition"
          >Home</a
        >
      </li>
      <li>
        <a
          href="#"
          class="text-md text-[#15164c] font-semibold hover:text-white transition"
          >Indoor Billboards</a
        >
      </li>
      <li>
        <a
          href="#"
          class="text-md text-[#15164c] font-semibold hover:text-white transition"
          >Solutions</a
        >
      </li>
      <li>
        <a
          href="#"
          class="text-md text-[#15164c] font-semibold hover:text-white transition"
          >About Us</a
        >
      </li>
      <li>
        <a
          href="#"
          class="text-md text-[#15164c] font-semibold hover:text-white transition"
          >Contact Us</a
        >
      </li>
    </ul>
  </nav>
</header>

<section class="relative bg-white py-15 md:py-28 lg:py-25">
  <div
    class="pointer-events-none absolute inset-0 z-0 opacity-60
           bg-center bg-no-repeat
           bg-[url('/images/online-banking-2.webp')]
           [background-size:100%_40%]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 container mx-auto max-w-screen-xl px-4">
    <div
      class="flex flex-wrap md:flex-nowrap items-center gap-10 lg:gap-16 min-h-[20vh] lg:min-h-[50vh]"
    >
      <!-- Left -->
      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <span
          class="w-fit self-start mb-6 inline-flex items-center rounded-full bg-[#9bb2f4] text-[#15164c] px-4 py-1 text-sm"
        >
          Premium Marketing Solutions
        </span>

        <h1
          class="text-[#15164c] font-bold leading-tight tracking-tight text-3xl md:text-4xl lg:text-5xl"
        >
          Local Advertising and Digital Marketing Pros in
          <span class="text-[#3b5de7]">Denver</span>
        </h1>

        <p class="mt-6 text-xl md:text-2xl text-[#15164c]/80 max-w-2xl">
          Helping Businesses Get Noticed On Screens and Online
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="#"
            class="inline-flex items-center justify-center h-12 px-6 rounded-lg bg-[#1d3dd1] text-white text-sm md:text-base font-semibold hover:bg-[#1833b2] transition"
          >
            Contact Our Advertising Experts
          </a>
        </div>
      </div>

      <!-- Right -->
      <div class="w-full md:w-1/2 flex justify-center md:justify-end">
        <div class="relative w-[22rem] sm:w-[26rem] md:w-[32rem] lg:w-[36rem]">
          <div
            class="absolute inset-0 -z-10 hidden md:block rounded-3xl bg-[#15164c] opacity-90 rotate-[-3deg]"
          >
          </div>
          <img
            src="/images/download-5-1.avif"
            alt="Digital signage montage"
            class="block w-full h-auto rounded-3xl shadow-xl object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-[90px] bg-[#141a56]">
  <div class="container mx-auto px-4">
    <div class="max-w-7xl mx-auto flex flex-row gap-20">
      <!-- LEFT: cards -->
      <div class="w-1/2">
        <div class="-m-1 flex flex-wrap">
          <div class="w-full sm:w-1/2 p-1">
            <div
              class="h-full min-h-[140px] rounded-lg bg-[#f6f9fe] p-6 sm:p-8 flex items-center justify-center text-center"
            >
              <p class="text-black text-xl">
                Ads displayed on indoor digital screens in high-traffic venues.
              </p>
            </div>
          </div>
          <div class="w-full sm:w-1/2 p-1">
            <div
              class="h-full min-h-[140px] rounded-lg bg-[#afc5f4] p-6 sm:p-8 flex items-center justify-center text-center"
            >
              <p class="text-black text-xl">
                Targeted placements by neighborhood, audience, or venue type.
              </p>
            </div>
          </div>
          <div class="w-full sm:w-1/2 p-1">
            <div
              class="h-full min-h-[140px] rounded-lg bg-[#afc5f4] p-6 sm:p-8 flex items-center justify-center text-center"
            >
              <p class="text-black text-xl">
                Flexible content scheduling and campaign reporting.
              </p>
            </div>
          </div>
          <div class="w-full sm:w-1/2 p-1">
            <div
              class="h-full min-h-[140px] rounded-lg bg-[#f6f9fe] p-6 sm:p-8 flex items-center justify-center text-center"
            >
              <p class="text-black text-xl">Custom motion-graphic designs.</p>
            </div>
          </div>
        </div>
      </div>
      <!-- RIGHT: text -->
      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <h2 class="text-4xl font-bold leading-tight text-white text-left">
          Reach Customers with
          <span class="text-[#3b5de7]">Indoor Digital Signage</span>
          Across
          <span class="text-[#3b5de7]">Denver</span>
        </h2>
        <p class="mt-4 text-xl text-white/80 text-left">
          Our (CITY) based indoor advertising network puts your brand in front
          of real people in real venues restaurants, gyms, salons, retail
          spaces, and more. Whether you are promoting daily specials or building
          brand awareness, our digital signage network delivers impactful,
          highfrequency exposure where it matters most.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="#"
            class="inline-flex items-center justify-center h-12 px-6 rounded-lg bg-[#0a379d] text-white text-sm md:text-base font-semibold hover:bg-[#1833b2] transition"
          >
            Explore Our Digital Ad Services
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="relative bg-[#e0edf6] py-15 md:py-28 lg:py-25">
  <div class="relative z-10 container mx-auto max-w-screen-xl px-4">
    <div
      class="flex flex-wrap md:flex-nowrap items-center gap-10 lg:gap-16 min-h-[20vh] lg:min-h-[50vh]"
    >
      <!-- Left -->
      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <h2
          class="text-[#15164c] font-bold leading-tight tracking-tight text-3xl"
        >
          Venue Partner Network
        </h2>

        <p class="mt-6 text-xl md:text-2xl text-[#15164c]/80 max-w-2xl">
          Our mission is to help local businesses like yours reach their
          audience. Every month, millions of consumers see our screens and
          remember them. <br />
          <br /> Join the network of businesses that are prioritizing hyper-local
          advertising!
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="#"
            class="inline-flex items-center justify-center h-12 px-6 rounded-lg bg-[#1d3dd1] text-white text-sm md:text-base font-semibold hover:bg-[#1833b2] transition"
          >
            Become a Venue Partner
          </a>
        </div>
      </div>

      <!-- Right -->
      <div class="w-full md:w-1/2 flex justify-center md:justify-end">
        <div class="relative w-[22rem] sm:w-[26rem] md:w-[32rem] lg:w-[36rem]">
          <div
            class="absolute inset-0 -z-10 hidden md:block rounded-3xl bg-[#15164c] opacity-90 rotate-[-3deg]"
          >
          </div>
          <img
            src="/images/download-3 (1).avif"
            alt="Digital signage montage"
            class="block w-full h-auto rounded-3xl shadow-xl object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-16 md:py-20 bg-white">
  <div class="container mx-auto w-7xl px-4">
    <!-- Heading -->
    <div class="max-w-full mx-auto text-center">
      <h2 class="text-4xl font-bold text-[#1d2a5b]">
        Boost Visibility with Our Full-Service Digital Marketing Solutions
      </h2>
      <p class="mt-4 text-black text-xl">
        Beyond in-venue ads, we provide full-scale digital marketing to help
        your business show up, stand out, and grow. Whether you're just getting
        started or need help scaling your outreach, we've got the tools and the
        team to support you.
      </p>
    </div>

    <!-- Grid -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-5">
      <!-- Left: big image, spans 2 rows -->
      <div class="relative lg:row-span-2">
        <!-- decorative back plate -->
        <div
          class="absolute -left-2 top-4 w-[94%] h-[94%] rounded-2xl bg-[#1d3dd1]/15 -z-10"
        >
        </div>

        <img
          src="/images/test2.avif"
          alt="Team working"
          class="w-full h-full object-cover rounded-2xl shadow-lg"
        />
      </div>

      <!-- Card 1 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- G icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 2a10 10 0 100 20 10 10 0 000-20Zm.2 15.2c-3.1 0-5.6-2.5-5.6-5.6s2.5-5.6 5.6-5.6c1.5 0 2.8.6 3.8 1.5l-1.5 1.5c-.6-.6-1.5-1-2.4-1-2 0-3.6 1.7-3.6 3.7s1.6 3.7 3.6 3.7c1.8 0 3.1-1 3.4-2.5H12v-2h5.6c.1.4.1.8.1 1.2 0 3.2-2.2 5.1-5.5 5.1Z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">
              Google Business Profile Optimization
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              Get found on Google Maps and local search.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 2 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- website icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" stroke-width="2"
              ></rect>
              <path d="M3 9h18" stroke-width="2"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">
              Website Design &amp; SEO
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              Fast, mobile-ready websites built for performance.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 3 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- hashtag icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M5 9h14M5 15h14M9 3L7 21M17 3l-2 18"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">Social Media Content</h3>
            <p class="mt-1 text-sm text-slate-600">
              Consistent posting and creative to grow your presence.
            </p>
          </div>
        </div>
      </a>

      <!-- Card 4 -->
      <a
        href="#"
        class="block rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- arrow icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M5 12h14M13 5l7 7-7 7"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-[#1d2a5b]">
              Pay-Per-Click Advertising
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              Targeted ads that drive calls, clicks, and leads.
            </p>
          </div>
        </div>
      </a>

      <!-- Bottom wide card (spans full width on large screens) -->
      <a
        href="#"
        class="lg:col-span-3 rounded-2xl bg-[#eaf1ff] p-5 md:p-6 ring-1 ring-white/60 shadow-sm hover:shadow transition"
      >
        <div class="flex items-start gap-3">
          <div class="mt-1 shrink-0">
            <!-- sparkles / info icon -->
            <svg
              class="w-7 h-7 text-[#1d3dd1]"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 3l1.8 3.7L18 8l-3.7 1.8L12 14l-1.8-4.2L6 8l4.2-1.3L12 3Zm7 9l.9 1.8L22 15l-2.1.2L19 18l-.9-2.8L16 15l2.1-1.2L19 11ZM5 13l.9 1.8L8 15l-2.1.2L5 18l-.9-2.8L2 15l2.1-1.2L5 13Z"
              ></path>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="font-semibold text-[#1d2a5b]">
              Check out all our Solutions
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              Explore tailored services designed to boost visibility, drive
              leads, and grow your business. Each solution is crafted to deliver
              real, measurable results.
            </p>
          </div>
          <!-- small accent badge -->
          <div
            class="hidden sm:flex items-center justify-center w-10 h-10 rounded-full bg-[#ffede3] text-[#e0592a]"
          >
            <!-- heart/check -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 21s-7.5-4.4-9.8-8.2C.6 10.4 2.3 7 5.7 7c1.8 0 3 .9 3.8 2 .8-1.1 2-2 3.8-2 3.4 0 5.1 3.4 3.5 5.8C19.5 16.6 12 21 12 21z"
              ></path>
            </svg>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<section class="relative bg-white py-15 md:py-28 lg:py-25">
  <div class="relative z-10 container mx-auto max-w-screen-xl px-4">
    <div
      class="flex flex-wrap md:flex-nowrap items-center gap-10 lg:gap-16 min-h-[20vh] lg:min-h-[50vh]"
    >
      <!-- Left -->
      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <h2
          class="text-[#15164c] font-bold leading-tight tracking-tight text-3xl"
        >
          Why Denver Businesses Choose Us
        </h2>

        <p class="mt-6 text-xl md:text-2xl text-[#15164c]/80 max-w-2xl">
          Our mission is to help local businesses like yours reach their
          audience. Every month, millions of consumers see our screens and
          remember them. <br />
          <br />Our combined expertise in indoor signage and digital strategy
          gives businesses like yours the visibility you deserve.
        </p>
      </div>

      <!-- Right -->
      <div class="w-full md:w-1/2 flex justify-center md:justify-end">
        <div class="relative w-[22rem] sm:w-[26rem] md:w-[32rem] lg:w-[36rem]">
          <div
            class="absolute inset-0 -z-10 hidden md:block rounded-3xl bg-[#15164c] opacity-90 rotate-[-3deg]"
          >
          </div>
          <img
            src="/images/test.webp"
            alt="Digital signage montage"
            class="block w-full h-auto rounded-3xl shadow-xl object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-12">
  <div class="relative z-10 container mx-auto max-w-screen-xl px-4">
    <!-- Card -->
    <div
      class="rounded-3xl bg-gradient-to-b from-[#0F3DA3] to-[#11184A]
             p-8 sm:p-12 lg:p-16 shadow-xl shadow-black/20"
    >
      <div class="mx-auto text-center">
        <h2
          class="text-white font-bold tracking-tight
                 text-4xl"
        >
          Let's Put Your Brand Where People Cannot Miss It
        </h2>

        <p class="mt-6 text-white/85 text-lg sm:text-xl leading-relaxed">
          Ready to amplify your local reach? Whether it's a screen in a
          restaurant or a click on Google, we help you meet your next customer
          wherever they are.
        </p>

        <div class="mt-10 flex justify-center">
          <a
            href="#"
            class="inline-flex items-center justify-center rounded-xl
                   h-12 px-6 text-white text-sm sm:text-base font-semibold
                   border border-white/80 hover:border-white
                   hover:bg-[#2ea3f2] transition"
          >
            Contact our Advertising Experts
            <svg
              class="ml-2 h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-20" x-data="{ category: 'general' }">
  <!-- Wider container: up to ~1440px, with comfy side padding -->
  <div class="mx-auto px-4 md:px-8 lg:px-16 max-w-[90rem]">
    <!-- Heading -->
    <div class="mx-auto max-w-7xl text-center mb-16">
      <h2 class="mt-2 mb-4 text-5xl font-bold leading-tight text-black">
        FAQs
      </h2>
    </div>

    <!-- Accordion list (wider) -->
    <div class="relative mx-auto max-w-7xl">
      <ul class="relative space-y-4">
        <!-- Item 1 -->
        <li class="p-1 border border-white/20 rounded-2xl">
