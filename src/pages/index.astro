---
import "../styles/global.css";
import Navbar from "../ui/navbar.astro";
import Footer from "../ui/Footer.astro";
import Hero from "../components/sections/hero.astro";
import ReachCustomers from "../components/sections/ReachCustomers.astro";
import VenuePartner from "../components/sections/VenuePartner.astro";
import BoostVisibility from "../components/sections/BoostVisibility.astro";
import WhyDenver from "../components/sections/WhyDenver.astro";
import CTA from "../components/sections/CTA.astro";
import FAQ from "../components/sections/FAQ.astro";
import Map from "../components/sections/Map.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>Top Shelf Advertising - Denver Indoor Digital Signage & Marketing</title>
    <meta name="title" content="Top Shelf Advertising - Denver Indoor Digital Signage & Marketing" />
    <meta name="description" content="Premier indoor digital signage and marketing solutions in Denver. Reach customers in restaurants, gyms, salons, and retail spaces with targeted advertising that drives results." />
    <meta name="keywords" content="Denver digital signage, indoor advertising, local marketing, digital displays, restaurant advertising, gym signage, retail marketing, Denver advertising agency" />
    <meta name="author" content="Top Shelf Advertising" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://topshelfadvertising.com/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://topshelfadvertising.com/" />
    <meta property="og:title" content="Top Shelf Advertising - Denver Indoor Digital Signage & Marketing" />
    <meta property="og:description" content="Premier indoor digital signage and marketing solutions in Denver. Reach customers in restaurants, gyms, salons, and retail spaces with targeted advertising that drives results." />
    <meta property="og:image" content="https://topshelfadvertising.com/images/TOP-SHELF-Advertising.webp" />
    <meta property="og:site_name" content="Top Shelf Advertising" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://topshelfadvertising.com/" />
    <meta property="twitter:title" content="Top Shelf Advertising - Denver Indoor Digital Signage & Marketing" />
    <meta property="twitter:description" content="Premier indoor digital signage and marketing solutions in Denver. Reach customers in restaurants, gyms, salons, and retail spaces with targeted advertising that drives results." />
    <meta property="twitter:image" content="https://topshelfadvertising.com/images/TOP-SHELF-Advertising.webp" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://unpkg.com" />
    <link rel="preconnect" href="https://tile.openstreetmap.org" />
    
    <!-- Preload critical resources -->
    <link rel="preload" href="/images/TOP-SHELF-Advertising.webp" as="image" type="image/webp" />
    <link rel="preload" href="/images/download-5-1.avif" as="image" type="image/avif" />
    <link rel="preload" href="/images/online-banking-2.webp" as="image" type="image/webp" />
    
    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="//unpkg.com" />
    <link rel="dns-prefetch" href="//tile.openstreetmap.org" />
    
    <!-- Local Business Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Top Shelf Advertising",
      "description": "Premier indoor digital signage and marketing solutions in Denver",
      "url": "https://topshelfadvertising.com",
      "telephone": "+1-XXX-XXX-XXXX",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Denver",
        "addressRegion": "CO",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "39.7392",
        "longitude": "-104.9903"
      },
      "areaServed": {
        "@type": "City",
        "name": "Denver",
        "sameAs": "https://en.wikipedia.org/wiki/Denver"
      },
      "serviceType": ["Digital Signage", "Indoor Advertising", "Digital Marketing", "Local Advertising"],
      "priceRange": "$$",
      "openingHours": "Mo-Fr 09:00-17:00"
    }
    </script>
    
    <!-- Alpine.js -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body>
    <Navbar />
    <Hero />
    <ReachCustomers />
    <VenuePartner />
    <BoostVisibility />
    <WhyDenver />
    <CTA />
    <FAQ />
    <Map />
    <Footer />
  </body>
</html>
