---
// Clean & Modern Navbar Component
---

<nav class="navbar">
  <div class="navbar-container">
    <!-- Logo -->
    <div class="navbar-logo">
      <a href="/" class="logo-link">
        <img src="/images/TOP-SHELF-Advertising.webp" alt="Top Shelf Advertising - Denver Digital Marketing and Indoor Signage" class="logo-image" loading="eager" decoding="async" width="200" height="60" />
      </a>
    </div>

    <!-- Hamburger Menu Button -->
    <button class="hamburger-menu" id="hamburger-menu" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- Navigation Menu -->
    <div class="navbar-menu" id="navbar-menu" role="navigation">
      <ul class="navbar-nav" role="menubar">
        <li class="nav-item" role="none">
          <a href="/" class="nav-link" role="menuitem">Home</a>
        </li>
        <li class="nav-item dropdown" role="none">
          <a href="#" class="nav-link dropdown-toggle" role="menuitem" aria-haspopup="true" aria-expanded="false">
            Indoor Billboards
            <svg class="dropdown-icon" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L6 5.5L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="dropdown-menu" role="menu">
            <li role="none"><a href="/indoor-billboards" class="dropdown-link" role="menuitem">View All</a></li>
            <li role="none"><a href="/indoor-billboards#restaurants" class="dropdown-link" role="menuitem">Restaurants</a></li>
            <li role="none"><a href="/indoor-billboards#retail" class="dropdown-link" role="menuitem">Retail Stores</a></li>
            <li role="none"><a href="/indoor-billboards#offices" class="dropdown-link" role="menuitem">Office Buildings</a></li>
          </ul>
        </li>
        <li class="nav-item dropdown" role="none">
          <a href="#" class="nav-link dropdown-toggle" role="menuitem" aria-haspopup="true" aria-expanded="false">
            Solutions
            <svg class="dropdown-icon" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L6 5.5L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="dropdown-menu" role="menu">
            <li role="none"><a href="/solutions#digital-displays" class="dropdown-link" role="menuitem">Digital Displays</a></li>
            <li role="none"><a href="/solutions#content-management" class="dropdown-link" role="menuitem">Content Management</a></li>
            <li role="none"><a href="/solutions#analytics" class="dropdown-link" role="menuitem">Analytics</a></li>
            <li role="none"><a href="/solutions#support" class="dropdown-link" role="menuitem">Support</a></li>
          </ul>
        </li>
        <li class="nav-item" role="none">
          <a href="/about" class="nav-link" role="menuitem">About Us</a>
        </li>
        <li class="nav-item cta-item" role="none">
          <a href="/contact" class="nav-link cta-link" role="menuitem">Contact Us</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* Clean Modern Design System */
  :root {
    --navbar-bg: #ffffff;
    --navbar-border: #f1f5f9;
    --navbar-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    --navbar-shadow-hover: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-light: #dbeafe;
    
    --text-primary: #1e293b;
    --text-secondary: #64748b;
    --text-muted: #94a3b8;
    
    --gray-50: #f8fafc;
    --gray-100: #f1f5f9;
    --gray-200: #e2e8f0;
    --gray-300: #cbd5e1;
    
    --border-radius: 8px;
    --border-radius-lg: 12px;
    --border-radius-xl: 16px;
    
    --spacing-xs: 0.25rem;
    --spacing-sm: 0.5rem;
    --spacing-md: 0.75rem;
    --spacing-lg: 1rem;
    --spacing-xl: 1.5rem;
    --spacing-2xl: 2rem;
    
    --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    
    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    
    --letter-spacing: -0.025em;
    --line-height: 1.5;
  }

  /* Base Navbar Styles */
  .navbar {
    background: var(--navbar-bg);
    border-bottom: 1px solid var(--navbar-border);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: var(--transition);
  }

  .navbar.scrolled {
    box-shadow: var(--navbar-shadow);
    border-bottom-color: var(--gray-200);
  }

  .navbar-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg) var(--spacing-2xl);
    min-height: 80px;
  }

  /* Logo Styles */
  .navbar-logo {
    display: flex;
    align-items: center;
    z-index: 1001;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: var(--transition);
    padding: var(--spacing-xs);
  }

  .logo-link:hover {
    transform: scale(1.02);
  }

  .logo-link:focus {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  .logo-image {
    height: 52px;
    width: auto;
    object-fit: contain;
    transition: var(--transition);
  }

  /* Hamburger Menu Styles */
  .hamburger-menu {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: var(--spacing-md);
    border-radius: var(--border-radius);
    transition: var(--transition);
    z-index: 1001;
  }

  .hamburger-menu:hover {
    background: var(--gray-50);
  }

  .hamburger-menu:focus {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
    background: var(--gray-50);
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: var(--transition-slow);
    margin: 2px 0;
  }

  .hamburger-menu.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .hamburger-menu.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scale(0);
  }

  .hamburger-menu.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  /* Navigation Menu Styles */
  .navbar-menu {
    display: flex;
    align-items: center;
  }

  .navbar-nav {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: var(--font-weight-medium);
    font-size: 0.95rem;
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--border-radius);
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    letter-spacing: var(--letter-spacing);
    line-height: var(--line-height);
    white-space: nowrap;
  }

  .nav-link:hover {
    background: var(--gray-50);
    color: var(--primary-color);
  }

  .nav-link:focus {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
    background: var(--gray-50);
  }

  /* CTA Button Styles */
  .cta-link {
    background: var(--primary-color);
    color: white !important;
    font-weight: var(--font-weight-semibold);
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: var(--border-radius-lg);
    transition: var(--transition);
    margin-left: var(--spacing-sm);
    box-shadow: 0 1px 2px 0 rgba(37, 99, 235, 0.2);
  }

  .cta-link:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px 0 rgba(37, 99, 235, 0.3);
  }

  .cta-link:active {
    transform: translateY(0);
    box-shadow: 0 1px 2px 0 rgba(37, 99, 235, 0.2);
  }

  .cta-link:focus {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  /* Dropdown Styles */
  .dropdown-icon {
    transition: var(--transition);
    opacity: 0.6;
    flex-shrink: 0;
  }

  .dropdown:hover .dropdown-icon,
  .dropdown.active .dropdown-icon {
    transform: rotate(180deg);
    opacity: 1;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + var(--spacing-sm));
    left: 0;
    background: var(--navbar-bg);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-xl);
    min-width: 220px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.95);
    transition: var(--transition-slow);
    list-style: none;
    padding: var(--spacing-md);
    margin: 0;
    z-index: 1001;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .dropdown:hover .dropdown-menu,
  .dropdown.active .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .dropdown-link {
    display: block;
    padding: var(--spacing-md) var(--spacing-lg);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: var(--transition);
    font-size: 0.9rem;
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
  }

  .dropdown-link:hover {
    background: var(--gray-50);
    color: var(--primary-color);
  }

  .dropdown-link:focus {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
    background: var(--gray-50);
  }

  /* Tablet Styles */
  @media (max-width: 1024px) {
    .navbar-container {
      padding: var(--spacing-lg) var(--spacing-xl);
    }

    .navbar-nav {
      gap: 0;
    }

    .nav-link {
      font-size: 0.9rem;
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .cta-link {
      padding: var(--spacing-sm) var(--spacing-lg);
    }
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .hamburger-menu {
      display: flex;
    }

    .navbar-menu {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background: var(--navbar-bg);
      transform: translateX(-100%);
      transition: var(--transition-slow);
      overflow-y: auto;
      box-shadow: var(--navbar-shadow-hover);
      padding-top: 5rem;
    }

    .navbar-menu.active {
      transform: translateX(0);
    }

    .navbar-nav {
      flex-direction: column;
      padding: var(--spacing-2xl);
      gap: var(--spacing-sm);
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }

    .nav-item {
      width: 100%;
    }

    .nav-link {
      padding: var(--spacing-lg) var(--spacing-xl);
      width: 100%;
      font-size: 1.1rem;
      justify-content: center;
      border-radius: var(--border-radius-lg);
      text-align: center;
    }

    .cta-link {
      margin: var(--spacing-lg) 0 0 0;
      padding: var(--spacing-lg) var(--spacing-2xl);
      font-size: 1.1rem;
    }

    /* Mobile Dropdown Styles */
    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      background: var(--gray-50);
      margin-top: var(--spacing-md);
      border: 1px solid var(--gray-200);
      display: none;
      width: 100%;
      border-radius: var(--border-radius-lg);
    }

    .dropdown.active .dropdown-menu {
      display: block;
      animation: slideDown var(--transition-slow) ease-out;
    }

    .dropdown-link {
      padding: var(--spacing-lg) var(--spacing-xl);
      font-size: 1rem;
      text-align: center;
    }

    .dropdown-link:hover {
      background: var(--gray-100);
    }
  }

  /* Small Mobile Styles */
  @media (max-width: 480px) {
    .navbar-container {
      padding: var(--spacing-md) var(--spacing-lg);
      min-height: 72px;
    }

    .logo-image {
      height: 44px;
    }

    .hamburger-menu {
      width: 44px;
      height: 44px;
    }

    .hamburger-line {
      width: 20px;
    }

    .navbar-nav {
      padding: var(--spacing-xl);
    }

    .nav-link {
      font-size: 1rem;
      padding: var(--spacing-md) var(--spacing-lg);
    }

    .cta-link {
      padding: var(--spacing-md) var(--spacing-xl);
      font-size: 1rem;
    }

    .dropdown-link {
      font-size: 0.95rem;
      padding: var(--spacing-md) var(--spacing-lg);
    }
  }

  /* Animations */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Accessibility and Motion Preferences */
  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* High Contrast Mode Support */
  @media (prefers-contrast: high) {
    .navbar {
      border-bottom: 2px solid var(--text-primary);
    }
    
    .nav-link:focus,
    .hamburger-menu:focus,
    .logo-link:focus,
    .cta-link:focus {
      outline: 3px solid var(--primary-color);
    }
    
    .dropdown-menu {
      border: 2px solid var(--gray-300);
    }
  }

  /* Print Styles */
  @media print {
    .navbar {
      position: static;
      box-shadow: none;
      border-bottom: 1px solid var(--gray-300);
    }
    
    .hamburger-menu {
      display: none;
    }
    
    .navbar-menu {
      display: block;
    }
    
    .dropdown-menu {
      display: none;
    }
  }
</style>

<script>
  // Clean Modern Navbar Class
  class CleanNavbar {
    hamburgerMenu: HTMLElement | null;
    navbarMenu: HTMLElement | null;
    navbar: HTMLElement | null;
    dropdownToggles: NodeListOf<Element>;
    dropdowns: NodeListOf<Element>;
    navLinks: NodeListOf<Element>;
    isMenuOpen: boolean;
    activeDropdown: Element | null;
    scrollThreshold: number;

    constructor() {
      this.hamburgerMenu = document.getElementById('hamburger-menu');
      this.navbarMenu = document.getElementById('navbar-menu');
      this.navbar = document.querySelector('.navbar');
      this.dropdownToggles = document.querySelectorAll('.dropdown-toggle');
      this.dropdowns = document.querySelectorAll('.dropdown');
      this.navLinks = document.querySelectorAll('.nav-link:not(.dropdown-toggle)');
      
      this.isMenuOpen = false;
      this.activeDropdown = null;
      this.scrollThreshold = 10;
      
      this.init();
    }

    init() {
      this.bindEvents();
      this.handleScroll();
      this.setupAccessibility();
    }

    bindEvents() {
      // Hamburger menu functionality
      this.hamburgerMenu?.addEventListener('click', this.toggleMobileMenu.bind(this));
      this.hamburgerMenu?.addEventListener('keydown', this.handleKeydown.bind(this) as EventListener);

      // Dropdown functionality
      this.dropdownToggles.forEach((toggle: Element) => {
        toggle.addEventListener('click', this.handleDropdownClick.bind(this) as EventListener);
        toggle.addEventListener('keydown', this.handleDropdownKeydown.bind(this) as EventListener);
      });

      // Navigation link clicks (mobile)
      this.navLinks.forEach((link: Element) => {
        link.addEventListener('click', this.handleNavLinkClick.bind(this));
      });

      // Global event listeners
      document.addEventListener('click', this.handleOutsideClick.bind(this));
      window.addEventListener('resize', this.handleResize.bind(this));
      window.addEventListener('scroll', this.throttle(this.handleScroll.bind(this), 16) as EventListener);
      document.addEventListener('keydown', this.handleEscape.bind(this) as EventListener);
      
      // Page visibility change
      document.addEventListener('visibilitychange', this.handleVisibilityChange.bind(this));
    }

    setupAccessibility() {
      // Set initial ARIA attributes
      this.hamburgerMenu?.setAttribute('aria-expanded', 'false');
      
      this.dropdownToggles.forEach((toggle: Element) => {
        toggle.setAttribute('aria-expanded', 'false');
      });
    }

    toggleMobileMenu() {
      this.isMenuOpen = !this.isMenuOpen;
      
      this.hamburgerMenu?.classList.toggle('active', this.isMenuOpen);
      this.navbarMenu?.classList.toggle('active', this.isMenuOpen);
      
      // Update ARIA attributes
      this.hamburgerMenu?.setAttribute('aria-expanded', this.isMenuOpen.toString());
      
      // Prevent body scroll when menu is open
      document.body.style.overflow = this.isMenuOpen ? 'hidden' : '';
      
      // Close all dropdowns when toggling menu
      if (this.isMenuOpen) {
        this.closeAllDropdowns();
      }
    }

    handleKeydown(e: KeyboardEvent): void {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        this.toggleMobileMenu();
      }
    }

    handleDropdownClick(e: Event): void {
      if (window.innerWidth <= 768) {
        e.preventDefault();
        const target = e.target as HTMLElement;
        const dropdown = target?.closest('.dropdown');
        const isActive = dropdown?.classList.contains('active');
        
        // Close all other dropdowns
        this.dropdowns.forEach((d: Element) => {
          if (d !== dropdown) {
            d.classList.remove('active');
            d.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
          }
        });
        
        // Toggle current dropdown
        dropdown?.classList.toggle('active');
        target.setAttribute('aria-expanded', (!isActive).toString());
        
        this.activeDropdown = isActive ? null : dropdown;
      }
    }

    handleDropdownKeydown(e: KeyboardEvent): void {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        this.handleDropdownClick(e);
      }
    }

    handleNavLinkClick(): void {
      if (window.innerWidth <= 768 && this.isMenuOpen) {
        this.closeMobileMenu();
      }
    }

    handleOutsideClick(e: Event): void {
      const target = e.target as HTMLElement;
      const isClickInsideNav = this.hamburgerMenu?.contains(target) || 
                              this.navbarMenu?.contains(target);
      
      if (!isClickInsideNav) {
        this.closeMobileMenu();
        this.closeAllDropdowns();
      }
    }

    handleResize(): void {
      if (window.innerWidth > 768) {
        this.closeMobileMenu();
        this.closeAllDropdowns();
      }
    }

    handleScroll(e?: Event): void {
      const scrolled = window.scrollY > this.scrollThreshold;
      this.navbar?.classList.toggle('scrolled', scrolled);
    }

    handleEscape(e: KeyboardEvent): void {
      if (e.key === 'Escape') {
        this.closeMobileMenu();
        this.closeAllDropdowns();
      }
    }

    handleVisibilityChange(): void {
      if (document.hidden) {
        this.closeMobileMenu();
        this.closeAllDropdowns();
      }
    }

    closeMobileMenu(): void {
      this.isMenuOpen = false;
      this.hamburgerMenu?.classList.remove('active');
      this.navbarMenu?.classList.remove('active');
      this.hamburgerMenu?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    closeAllDropdowns(): void {
      this.dropdowns.forEach((dropdown: Element) => {
        dropdown.classList.remove('active');
        dropdown.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
      });
      this.activeDropdown = null;
    }

    // Utility function for throttling
    throttle<T extends (...args: any[]) => void>(func: T, limit: number): (this: any, ...args: Parameters<T>) => void {
      let inThrottle: boolean;
      return function(this: any, ...args: Parameters<T>) {
        if (!inThrottle) {
          func.apply(this, args);
          inThrottle = true;
          setTimeout(() => inThrottle = false, limit);
        }
      }
    }
  }

  // Initialize navbar when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new CleanNavbar();
  });
</script>